# src/render 모듈 전용 — 의존 그래프 시각화 focused Doxyfile
# 실행: doxygen doc/doxygen/render-deps/Doxyfile  (프로젝트 루트에서)

# ─── Project ─────────────────────────────────────────────────────────────
PROJECT_NAME           = "SJH::render — Dependency Graph"
PROJECT_BRIEF          = "src/render 모듈의 include / class / collaboration / directory 그래프"
OUTPUT_DIRECTORY       = doc/doxygen/render-deps/output
OUTPUT_LANGUAGE        = English
TAB_SIZE               = 4
OPTIMIZE_OUTPUT_FOR_C  = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES

# ─── Input ───────────────────────────────────────────────────────────────
INPUT                  = doc/doxygen/render-deps/mainpage.md src/render
USE_MDFILE_AS_MAINPAGE = doc/doxygen/render-deps/mainpage.md
RECURSIVE              = NO
FILE_PATTERNS          = *.h *.cpp *.md
EXCLUDE_PATTERNS       = */build*/* */extern/*

# include 경로 — cross-module forward decl 해석 (그래프 노드 정확도 향상)
INCLUDE_PATH           = src include
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = src include

# ─── Extraction ──────────────────────────────────────────────────────────
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = YES

# ─── Source browser ──────────────────────────────────────────────────────
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

# ─── Output formats ──────────────────────────────────────────────────────
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = DARK
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
HTML_DYNAMIC_SECTIONS  = YES
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES

# ─── DOT / Graphviz — 그래프 본체 ────────────────────────────────────────
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DIR_GRAPH_MAX_DEPTH    = 3

# SVG + interactive — 마우스로 확대/탐색 가능
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 200
MAX_DOT_GRAPH_DEPTH    = 0
DOT_MULTI_TARGETS      = YES
DOT_CLEANUP            = YES

# UML 식 클래스 박스 — 멤버/메서드까지 노출
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 50
TEMPLATE_RELATIONS     = YES

# ─── Diagnostics ─────────────────────────────────────────────────────────
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
