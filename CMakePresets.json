{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build_${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_MANIFEST_INSTALL": "ON"
            }
        },
        {
            "name": "base-ninja",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "base-msvc",
            "hidden": true,
            "inherits": "base",
            "binaryDir": "${sourceDir}/build_msvc",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static"
            }
        },
        {
            "name": "ninja",
            "inherits": "base-ninja",
            "displayName": "Ninja Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ninja-release",
            "inherits": "base-ninja",
            "displayName": "Ninja Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ninja-golden",
            "inherits": "ninja",
            "displayName": "Ninja Debug (골든 캡처 게이트)",
            "description": "_MyApp_ 를 capture_application 진입점으로 빌드하고 골든 ctest 체인을 등록한다. build_ninja 와 별도 디렉토리라 게임 빌드와 공존. ★ base-ninja 가 아니라 ninja 를 상속하는 이유 = 게이트가 검증하는 바이너리가 실제 게임 빌드와 동일 설정이어야 하기 때문 - ninja 에 캐시 변수가 추가되면 자동 전파된다(드리프트 방지). 여기 cacheVariables 는 캡처 전용 델타만 둘 것.",
            "cacheVariables": {
                "SJH_GOLDEN_CAPTURE": "ON",
                "ENABLE_TESTING": "ON",
                "VCPKG_MANIFEST_FEATURES": "golden"
            }
        },
        {
            "name": "msvc",
            "inherits": "base-msvc",
            "displayName": "MSVC (Visual Studio 2019, v142)",
            "generator": "Visual Studio 16 2019",
            "toolset": "v142"
        },
        {
            "name": "msvc-2022",
            "inherits": "base-msvc",
            "displayName": "MSVC (Visual Studio 2022, v143)",
            "generator": "Visual Studio 17 2022",
            "toolset": "v143"
        }
    ],
    "buildPresets": [
        { "name": "ninja",         "configurePreset": "ninja" },
        { "name": "ninja-release", "configurePreset": "ninja-release" },
        { "name": "ninja-golden",  "configurePreset": "ninja-golden" },
        { "name": "msvc",          "configurePreset": "msvc",      "configuration": "Debug" },
        { "name": "msvc-release",  "configurePreset": "msvc",      "configuration": "Release" },
        { "name": "msvc-2022",         "configurePreset": "msvc-2022", "configuration": "Debug" },
        { "name": "msvc-2022-release", "configurePreset": "msvc-2022", "configuration": "Release" }
    ]
}
