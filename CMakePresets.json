{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build_${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_MANIFEST_INSTALL": "ON"
            }
        },
        {
            "name": "base-ninja",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "base-msvc",
            "hidden": true,
            "inherits": "base",
            "binaryDir": "${sourceDir}/build_msvc",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "description": "MSVC 공통.",
            "cacheVariables": {
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            }
        },
        {
            "name": "ninja",
            "inherits": "base-ninja",
            "displayName": "Ninja Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ninja-release",
            "inherits": "base-ninja",
            "displayName": "Ninja Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ninja-golden",
            "inherits": "ninja",
            "displayName": "Ninja Debug (골든 캡처 게이트)",
            "cacheVariables": {
                "SJH_GOLDEN_CAPTURE": "ON",
                "ENABLE_TESTING": "ON",
                "VCPKG_MANIFEST_FEATURES": "golden"
            }
        },
        {
            "name": "ninja-release-golden",
            "inherits": "ninja-release",
            "displayName": "Ninja Release (골든 캡처 게이트)",
            "cacheVariables": {
                "SJH_GOLDEN_CAPTURE": "ON",
                "ENABLE_TESTING": "ON",
                "VCPKG_MANIFEST_FEATURES": "golden"
            }
        },
        {
            "name": "msvc",
            "inherits": "base-msvc",
            "displayName": "MSVC (Visual Studio 2019, v142)",
            "generator": "Visual Studio 16 2019",
            "toolset": "v142"
        },
        {
            "name": "msvc-2022",
            "inherits": "base-msvc",
            "displayName": "MSVC (Visual Studio 2022, v143)",
            "generator": "Visual Studio 17 2022",
            "toolset": "v143"
        },
        {
            "name": "msvc-golden",
            "inherits": "msvc",
            "displayName": "MSVC 2019 (골든 캡처 게이트)",
            "binaryDir": "${sourceDir}/build_msvc-golden",
            "cacheVariables": {
                "SJH_GOLDEN_CAPTURE": "ON",
                "ENABLE_TESTING": "ON",
                "VCPKG_MANIFEST_FEATURES": "golden"
            }
        },
        {
            "name": "msvc-2022-golden",
            "inherits": "msvc-2022",
            "displayName": "MSVC 2022 (골든 캡처 게이트)",
            "binaryDir": "${sourceDir}/build_msvc-golden",
            "cacheVariables": {
                "SJH_GOLDEN_CAPTURE": "ON",
                "ENABLE_TESTING": "ON",
                "VCPKG_MANIFEST_FEATURES": "golden"
            }
        }
    ],
    "buildPresets": [
        { "name": "ninja",         "configurePreset": "ninja" },
        { "name": "ninja-release", "configurePreset": "ninja-release" },
        { "name": "ninja-golden",  "configurePreset": "ninja-golden" },
        { "name": "ninja-release-golden", "configurePreset": "ninja-release-golden" },
        { "name": "msvc",          "configurePreset": "msvc",      "configuration": "Debug" },
        { "name": "msvc-release",  "configurePreset": "msvc",      "configuration": "Release" },
        { "name": "msvc-2022",         "configurePreset": "msvc-2022", "configuration": "Debug" },
        { "name": "msvc-2022-release", "configurePreset": "msvc-2022", "configuration": "Release" },
        { "name": "msvc-golden",       "configurePreset": "msvc-golden",      "configuration": "Debug" },
        { "name": "msvc-2022-golden",  "configurePreset": "msvc-2022-golden", "configuration": "Debug" }
    ]
}
